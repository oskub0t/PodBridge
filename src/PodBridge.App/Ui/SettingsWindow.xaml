<Window x:Class="PodBridge.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PodBridge.App.Ui"
        Title="AirPods" Icon="/PodBridge;component/Assets/PodBridge.ico" Width="620" Height="800" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Fill" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="4,26,0,8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,36" MaxWidth="620">

            <!-- Hero: illustration, name, state, one action -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:DeviceArt Width="112" Height="112"/>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource Title}" FontSize="26" Text="AirPods"/>
                    <TextBlock x:Name="StateText" Style="{StaticResource Secondary}" Margin="0,2,0,12" Text="Not connected"/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource PrimaryButton}" Height="34" Width="132"
                            HorizontalAlignment="Left" FontSize="14" Content="Connect"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Group}" Margin="0,24,0,0" Padding="8,18,8,14">
                <ui:BatteryRow x:Name="Batteries"/>
            </Border>

            <!-- Connection -->
            <TextBlock Style="{StaticResource Header}" Text="CONNECTION"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Connect to This PC"/>
                        <ComboBox x:Name="SwitchCombo" Grid.Column="1" MinWidth="150">
                            <ComboBoxItem Content="Automatically"/>
                            <ComboBoxItem Content="When Asked"/>
                            <ComboBoxItem Content="Never"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource RowNote}"
                               Text="When you're wearing your AirPods with another device and this PC starts playing or a call starts."/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="AutoConnectSw" Style="{StaticResource Switch}" Content="Connect when case opens"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="PopupSw" Style="{StaticResource Switch}" Content="Show battery when case opens"/>
                </StackPanel>
            </Border>

            <!-- Ear detection -->
            <TextBlock Style="{StaticResource Header}" Text="EAR DETECTION"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="EarSw" Style="{StaticResource Switch}" Content="Automatic Ear Detection"/>
                    <TextBlock Style="{StaticResource RowNote}"
                               Text="Pauses when you take an AirPod out and resumes when you put it back. On Windows this takes a second or two."/>
                </StackPanel>
            </Border>

            <!-- Calls -->
            <TextBlock Style="{StaticResource Header}" Text="CALLS"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="CallSw" Style="{StaticResource Switch}" Content="Use AirPods mic automatically in calls"/>
                    <TextBlock Style="{StaticResource RowNote}"
                               Text="Switches to the AirPods mic when Teams, Zoom, Slack or Webex starts using a microphone, and back to high-quality audio afterwards."/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="SilentMicSw" Style="{StaticResource Switch}" Content="Warn when the AirPods mic gets no audio"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="LaptopMicSw" Style="{StaticResource Switch}" Content="Use this PC's mic outside calls"/>
                    <TextBlock Style="{StaticResource RowNote}"
                               Text="Keeps other apps from switching your AirPods to lower-quality headset audio when they open the default microphone."/>
                </StackPanel>
            </Border>

            <!-- Notifications + general -->
            <TextBlock Style="{StaticResource Header}" Text="GENERAL"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="LowBatterySw" Style="{StaticResource Switch}" Content="Low battery alerts"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="LoginSw" Style="{StaticResource Switch}" Content="Open at login"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="MaterialsSw" Style="{StaticResource Switch}" Content="Translucent cards"/>
                </StackPanel>
            </Border>

            <!-- Advanced features: optional, OFF by default, need a separately installed driver (admin) -->
            <TextBlock Style="{StaticResource Header}" Text="ADVANCED FEATURES"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowLabel}" FontWeight="SemiBold" Margin="10,12,10,6"
                               Text="Noise control, Conversation Awareness, exact battery"/>
                    <Border HorizontalAlignment="Left" Margin="10,0,10,8" CornerRadius="6" Padding="8,3"
                            Background="{DynamicResource FillHoverBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEA18;" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarnBrush}" Margin="0,0,6,0"/>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" FontWeight="SemiBold"
                                       Text="Requires administrator · Off by default"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="AdvancedNote" Style="{StaticResource RowNote}"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <CheckBox x:Name="AdvancedSw" Style="{StaticResource Switch}" Content="Use advanced features"/>

                    <StackPanel x:Name="AdvancedControls" Visibility="Collapsed">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <TextBlock Style="{StaticResource RowLabel}" Margin="10,10,10,6" Text="Noise Control"/>
                        <Border Style="{StaticResource Group}" Margin="10,0,10,10" Background="{DynamicResource FillHoverBrush}">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="NcOff" Style="{StaticResource Segment}" GroupName="Nc" Content="Off"/>
                                <RadioButton x:Name="NcTransparency" Style="{StaticResource Segment}" GroupName="Nc" Content="Transparency"/>
                                <RadioButton x:Name="NcAdaptive" Style="{StaticResource Segment}" GroupName="Nc" Content="Adaptive"/>
                                <RadioButton x:Name="NcAnc" Style="{StaticResource Segment}" GroupName="Nc" Content="Noise Cancellation"/>
                            </UniformGrid>
                        </Border>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <CheckBox x:Name="CaSw" Style="{StaticResource Switch}" Content="Conversation Awareness"/>
                        <TextBlock Style="{StaticResource RowNote}"
                                   Text="Lowers media and brings voices forward when you start talking."/>
                    </StackPanel>

                    <Button x:Name="AdvancedHelpBtn" Style="{StaticResource TextButton}" HorizontalAlignment="Left"
                            Margin="2,0,0,6" Content="How advanced features work…"/>
                </StackPanel>
            </Border>

            <!-- What the AirPods do on their own -->
            <TextBlock Style="{StaticResource Header}" Text="ON YOUR AIRPODS"/>
            <Border Style="{StaticResource Group}" Padding="10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Press the stem to play or pause"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE893;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Press twice to skip, three times to go back"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F6;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Press and hold to switch Noise Cancellation and Transparency"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;"/>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Swipe the stem to change volume"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="28,10,0,4"
                               Text="These work on Windows by themselves. Changing them, and Conversation Awareness, Adaptive Audio, spatial audio and hearing features, needs Apple's private connection to the AirPods. Windows only allows that through a driver, which needs administrator rights, so PodBridge doesn't offer them."/>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Style="{StaticResource Header}" Text="ABOUT"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <Grid Margin="10,10">
                        <TextBlock Style="{StaticResource RowLabel}" Text="Model"/>
                        <TextBlock x:Name="ModelText" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Text="–"/>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Grid Margin="10,10">
                        <TextBlock Style="{StaticResource RowLabel}" Text="Bluetooth name"/>
                        <TextBlock x:Name="BtNameText" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Text="–"/>
                    </Grid>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="LearnBtn" Content="Set Up Different AirPods…" Margin="0,0,8,8" Padding="14,6"/>
                <Button x:Name="DiagBtn" Content="Copy Diagnostics" Margin="0,0,8,8" Padding="14,6"/>
                <Button x:Name="BtSettingsBtn" Content="Bluetooth Settings…" Margin="0,0,8,8" Padding="14,6"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
