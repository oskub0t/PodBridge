<Window x:Class="PodBridge.App.Ui.StatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PodBridge.App.Ui"
        Style="{StaticResource CardWindow}" Width="376" Title="PodBridge">
    <Border Style="{StaticResource Card}" Padding="18,20,18,14">
        <StackPanel>
            <!-- Header: device + connection state -->
            <Grid Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock x:Name="DeviceText" Style="{StaticResource Title}" Text="AirPods"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource SecondaryLabelBrush}"
                                 VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="StateText" Style="{StaticResource Secondary}" Text="Not connected"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ConnectBtn" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" FontWeight="SemiBold" Content="Connect"/>
            </Grid>

            <ui:BatteryRow x:Name="Batteries" Margin="0,18,0,4"/>

            <!-- Warning banner (silent mic, Bluetooth blocked, ...) -->
            <Border x:Name="Banner" CornerRadius="12" Background="{DynamicResource FillBrush}" Padding="12,10"
                    Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                    <TextBlock x:Name="BannerText" Grid.Column="1" Style="{StaticResource Body}" FontSize="13"/>
                </Grid>
            </Border>

            <Rectangle Style="{StaticResource Separator}" Margin="0,16,0,14"/>

            <!-- Mode: segmented control -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="AUDIO MODE"/>
            <Border Style="{StaticResource Group}">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="MusicSeg" Style="{StaticResource Segment}" GroupName="Mode" Content="Music"/>
                    <RadioButton x:Name="CallSeg" Style="{StaticResource Segment}" GroupName="Mode" Content="Call"/>
                </UniformGrid>
            </Border>
            <TextBlock x:Name="ModeHint" Style="{StaticResource Secondary}" FontSize="12" Margin="4,6,4,0"
                       Text="High-quality stereo. Switches to the AirPods mic automatically when a call starts."/>

            <!-- Settings group -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="BEHAVIOUR" Margin="4,18,0,6"/>
            <Border Style="{StaticResource Group}">
                <StackPanel>
                    <CheckBox x:Name="AutoConnectSw" Style="{StaticResource Switch}" Content="Connect when case opens"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="10,0"/>
                    <CheckBox x:Name="PopupSw" Style="{StaticResource Switch}" Content="Show battery when case opens"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="10,0"/>
                    <CheckBox x:Name="CallSw" Style="{StaticResource Switch}" Content="Switch automatically for calls"/>
                    <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="10,0"/>
                    <CheckBox x:Name="LoginSw" Style="{StaticResource Switch}" Content="Open at login"/>
                </StackPanel>
            </Border>

            <Rectangle Style="{StaticResource Separator}" Margin="0,14,0,6"/>

            <Button x:Name="LearnBtn" Style="{StaticResource RowButton}" Content="Set Up My AirPods…"/>
            <Button x:Name="DiagBtn" Style="{StaticResource RowButton}" Content="Copy Diagnostics"/>
            <Button x:Name="BtSettingsBtn" Style="{StaticResource RowButton}" Content="Bluetooth Settings…"/>
            <Button x:Name="QuitBtn" Style="{StaticResource RowButton}" Content="Quit PodBridge"/>
        </StackPanel>
    </Border>
</Window>
