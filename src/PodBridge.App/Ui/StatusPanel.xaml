<Window x:Class="PodBridge.App.Ui.StatusPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PodBridge.App.Ui"
        Style="{StaticResource CardWindow}" Width="360" Title="PodBridge">
    <!-- Quick view only, like a menu-bar extra. Everything else lives in Settings. -->
    <Border x:Name="CardBorder" Style="{StaticResource Card}" Padding="18,18,18,12">
        <StackPanel>
            <Grid Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock x:Name="DeviceText" Style="{StaticResource Title}" Text="AirPods"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="{DynamicResource SecondaryLabelBrush}"
                                 VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="StateText" Style="{StaticResource Secondary}" Text="Not connected"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ConnectBtn" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" FontWeight="SemiBold" Content="Connect"/>
            </Grid>

            <ui:BatteryRow x:Name="Batteries" Margin="0,18,0,4"/>

            <Border x:Name="Banner" CornerRadius="10" Background="{DynamicResource FillBrush}" Padding="12,10"
                    Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                    <TextBlock x:Name="BannerText" Grid.Column="1" Style="{StaticResource Body}" FontSize="13"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Group}" Margin="0,16,0,0">
                <UniformGrid Columns="2">
                    <RadioButton x:Name="MusicSeg" Style="{StaticResource Segment}" GroupName="Mode" Content="Music"/>
                    <RadioButton x:Name="CallSeg" Style="{StaticResource Segment}" GroupName="Mode" Content="Call"/>
                </UniformGrid>
            </Border>
            <TextBlock x:Name="ModeHint" Style="{StaticResource Secondary}" FontSize="12" Margin="4,6,4,0"/>

            <Rectangle Style="{StaticResource Separator}" Margin="0,12,0,4"/>
            <Button x:Name="SettingsBtn" Style="{StaticResource RowButton}" Content="AirPods Settings…"/>
            <Button x:Name="QuitBtn" Style="{StaticResource RowButton}" Content="Quit PodBridge"/>
        </StackPanel>
    </Border>
</Window>
