<UserControl x:Class="PodBridge.App.Ui.BatteryRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PodBridge.App.Ui">
    <UserControl.Resources>
        <Geometry x:Key="Bolt">M5,0 L0,7 L3.6,7 L2.6,12 L8,4.6 L4.4,4.6 Z</Geometry>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryLabelBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="BoltPath" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource Bolt}"/>
            <Setter Property="Fill" Value="{DynamicResource GoodBrush}"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <UniformGrid Columns="3">
        <StackPanel HorizontalAlignment="Center">
            <ui:BatteryRing x:Name="LeftRing" Kind="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Path x:Name="LeftBolt" Style="{StaticResource BoltPath}" Visibility="Collapsed"/>
                <TextBlock x:Name="LeftPct" Style="{StaticResource Pct}" Text="–"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Left"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center">
            <ui:BatteryRing x:Name="RightRing" Kind="Right"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Path x:Name="RightBolt" Style="{StaticResource BoltPath}" Visibility="Collapsed"/>
                <TextBlock x:Name="RightPct" Style="{StaticResource Pct}" Text="–"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Right"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Center">
            <ui:BatteryRing x:Name="CaseRing" Kind="Case"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Path x:Name="CaseBolt" Style="{StaticResource BoltPath}" Visibility="Collapsed"/>
                <TextBlock x:Name="CasePct" Style="{StaticResource Pct}" Text="–"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="Case"/>
        </StackPanel>
    </UniformGrid>
</UserControl>
