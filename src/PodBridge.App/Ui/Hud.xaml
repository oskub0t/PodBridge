<Window x:Class="PodBridge.App.Ui.Hud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource CardWindow}" SizeToContent="WidthAndHeight" ShowActivated="False"
        IsHitTestVisible="False" Title="PodBridge">
    <!-- Small capsule notice, like the macOS/iOS volume or "AirPods connected" HUD. -->
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="22" Padding="18,11,22,11" Margin="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource GoodBrush}" VerticalAlignment="Center"
                     Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource Headline}"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource Secondary}" FontSize="12" MaxWidth="300"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
