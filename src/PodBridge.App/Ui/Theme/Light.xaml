<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic colours, loosely following the iOS/macOS system palette. -->
    <SolidColorBrush x:Key="CardBrush" Color="#F5FBFBFD"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="LabelBrush" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="SecondaryLabelBrush" Color="#6E6E73"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="FillBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0066D6"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#34C759"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FF9500"/>
    <SolidColorBrush x:Key="LowBrush" Color="#FF3B30"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="GlyphBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#E5E5EA"/>
</ResourceDictionary>
