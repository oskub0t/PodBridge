<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004+; needed for the WinRT Bluetooth LE advertisement API. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Lets the solution build on Linux/macOS CI too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PodBridge</AssemblyName>
    <RootNamespace>PodBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/icon/make_icon.py -->
    <ApplicationIcon>Assets\PodBridge.ico</ApplicationIcon>
    <Version>0.4.8</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PodBridge.ico" />
    <Resource Include="Assets\airpods-hero.png" />
    <Resource Include="Assets\anim\*.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodBridge.Core\PodBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

</Project>
