<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004+; needed for the WinRT Bluetooth LE advertisement API. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon (WPF has no tray icon of its own). -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the solution build on Linux/macOS CI too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PodBridge</AssemblyName>
    <RootNamespace>PodBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/icon/make_icon.py -->
    <ApplicationIcon>Assets\PodBridge.ico</ApplicationIcon>
    <Version>0.3.5</Version>
    <!-- WPF needs PerMonitorV2 in the manifest; this WinForms hint does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF/WinForms name clashes (Application, Button, MessageBox...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PodBridge.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodBridge.Core\PodBridge.Core.csproj" />
  </ItemGroup>

</Project>
