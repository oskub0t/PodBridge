;
; PodBridge AAP driver (OPTIONAL, EXPERIMENTAL). Installing requires administrator rights.
; Attaches to the device node Windows creates for the AirPods' Apple Accessory Protocol service.
;
; Hardware IDs: Windows creates a device node named "AAP Server" for the AirPods' AAP service.
; CONFIRMED on AirPods Pro 3 (Windows 11 26200):
;   BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2027
; which also confirms that the product ID is the advertisement model ID with its bytes swapped
; (0x2720 -> PID 2027). The other models' IDs follow that rule but are UNCONFIRMED; check yours with
; driver\check-aap-service.ps1 (or the paste-in command in driver\README.md).
;
; Note: on that PC the AAP Server node already had a driver (Status OK). Which one is still to be
; checked; an inbox, Microsoft-signed match may outrank this test-signed driver, in which case pick
; it manually: Device Manager > AAP Server > Update driver > Browse > Let me pick > Have Disk.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ProviderName%
CatalogFile = podbridgeaap.cat
DriverVer   = 11/27/2026,0.1.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
podbridgeaap.sys = 1,,

[Manufacturer]
%ProviderName% = PodBridge, NTamd64.10.0...19041, NTarm64.10.0...19041

; AAP service UUID 74ec2172-0bad-4d01-8f77-997b2be0722a, Apple vendor ID (Bluetooth SIG source 0x0001, 0x004C)
[PodBridge.NTamd64.10.0...19041]
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2027 ; AirPods Pro 3 (confirmed)
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2014 ; AirPods Pro 2
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2024 ; AirPods Pro 2 USB-C
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2036 ; AirPods 5
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2019 ; AirPods 4
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&201b ; AirPods 4 ANC

[PodBridge.NTarm64.10.0...19041]
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2027
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2014
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2024
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2036
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&2019
%DeviceDesc% = PodBridge_Device, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}_VID&0001004c_PID&201b

[PodBridge_Device.NT]
CopyFiles = PodBridge_CopyFiles

[PodBridge_CopyFiles]
podbridgeaap.sys

; Let the signed-in user's PodBridge.exe open the device without admin:
; SYSTEM and Administrators full access, interactive users read/write.
[PodBridge_Device.NT.HW]
AddReg = PodBridge_Security

[PodBridge_Security]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[PodBridge_Device.NT.Services]
AddService = PodBridgeAap, 0x00000002, PodBridge_Service

[PodBridge_Service]
DisplayName   = %ServiceName%
ServiceType   = 1     ; kernel driver
StartType     = 3     ; on demand (loaded when the AirPods' device node appears)
ErrorControl  = 1
ServiceBinary = %13%\podbridgeaap.sys

[PodBridge_Device.NT.Wdf]
KmdfService = PodBridgeAap, PodBridge_Wdf

[PodBridge_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "PodBridge (open source)"
DiskName     = "PodBridge AAP driver"
DeviceDesc   = "PodBridge AirPods control channel"
ServiceName  = "PodBridge AAP driver"
